# Copy to .env, fill in, then `source ./env.sh` (it derives each app's prefixed variables from these).
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_ORGANIZATION_ID=          # cabinet/ (App SDK apps deploy to the org Dashboard)
WORKFLOW_TAG=dev                 # must match workflows/sanity.workflow.ts

# Tokens — server-side only, never in a browser bundle. Scope each one as narrowly as the plan allows.
SANITY_VOTE_TOKEN=               # web/: create/replace `vote` + `citizen` documents only
SANITY_AGENT_TOKEN=              # agent/: create `proposal` documents; must NOT be able to write `field`
SANITY_WORKFLOW_MCP_TOKEN=       # agent/: ORG-level token for @sanity/workflow-mcp; fire actions, no deploy
SANITY_DRAINER_TOKEN=            # workflows/runtime: writes `field` (watering) + engine instance writes
ANTHROPIC_API_KEY=               # agent/ (or `ant auth login` instead)

BRAWNDO_GROW_MINUTES=5           # watering → harvest delay

# Only if the plan has no custom roles (docs/DESIGN.md §8). Then the Cabinet is advisory — say so in the post.
# BRAWNDO_ROLE_CABINET=administrator
# BRAWNDO_ROLE_SECRETARY=editor
